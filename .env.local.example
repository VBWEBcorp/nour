# ─────────────────────────────────────────────────────────────
# Variables d'environnement du site BYS Consulting
# Copier ce fichier en `.env.local` et remplir avec les vraies valeurs.
# `.env.local` n'est jamais commité (voir .gitignore).
# ─────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════
# 1. NICOKA — offres d'emploi (ATS)
# ═════════════════════════════════════════════════════════════
# Nom de l'instance Nicoka, c'est-à-dire le sous-domaine utilisé dans
# https://<instance>.nicoka.com/public/jobs/
#
# L'instance de BYS Consulting est « bysconsulting » (transmise par Nour le
# 21/09/2026) et c'est la valeur par défaut du code : rien à renseigner.
# Ne poser cette variable que pour la remplacer ; une valeur vide désactive
# Nicoka et la page /candidats affiche les offres de démonstration.
# NEXT_PUBLIC_NICOKA_INSTANCE=bysconsulting


# ═════════════════════════════════════════════════════════════
# 2. EMAIL — formulaire de contact
# ═════════════════════════════════════════════════════════════
# Les messages partent vers la boîte de Nour (nour.boukhercha@bysconsulting.fr,
# valeur par défaut dans src/lib/seo.ts). CONTACT_TO permet de la remplacer,
# par exemple pour tester sans déranger la cliente.
# CONTACT_TO=contact@vbweb.fr

# --- Transport 1 : Resend (celui de la production) ---
# Clé « sending only » du compte Resend de l'agence, limitée au domaine vbweb.fr.
# L'expéditeur doit rester sur un domaine vérifié chez Resend (bysconsulting.fr
# ne l'est pas : la boîte de Nour est chez IONOS). Jamais d'adresse resend.dev.
RESEND_API_KEY=
# RESEND_FROM="BYS Consulting <contact@vbweb.fr>"

# --- Transport 2 : SMTP (si Nour transmet un jour les accès de sa boîte) ---
# Serveur SMTP du fournisseur de la boîte email :
#   IONOS      -> smtp.ionos.fr           (port 465)
#   OVH        -> ssl0.ovh.net            (port 465)
#   Gmail      -> smtp.gmail.com          (port 465, mot de passe d'application requis)
# SMTP_HOST=smtp.ionos.fr
# SMTP_PORT=465
# SMTP_USER=nour.boukhercha@bysconsulting.fr
# SMTP_PASS=
# Optionnel : expéditeur affiché (par défaut = SMTP_USER). Doit rester la boîte
# authentifiée pour ne pas partir en spam.
# SMTP_FROM="BYS Consulting <nour.boukhercha@bysconsulting.fr>"


# ═════════════════════════════════════════════════════════════
# 3. BASE DE DONNÉES — back-office (blog, galerie, contenus)
# ═════════════════════════════════════════════════════════════
# Chaîne de connexion MongoDB. En production, utiliser MongoDB Atlas
# (offre gratuite suffisante pour ce volume).
# Format : mongodb+srv://<user>:<motdepasse>@<cluster>.mongodb.net/bys
MONGODB_URI=mongodb://localhost:27017/bys

# Clé de signature des sessions admin. Générer une valeur aléatoire longue,
# par exemple avec : openssl rand -base64 48
JWT_SECRET=


# ═════════════════════════════════════════════════════════════
# 4. CLOUDFLARE R2 — stockage des images
# ═════════════════════════════════════════════════════════════
# Créer un bucket R2 dans le compte Cloudflare, puis un jeton d'API
# « Object Read & Write » limité à ce bucket.
#
# Identifiant du compte Cloudflare (visible dans l'URL du dashboard)
R2_ACCOUNT_ID=

# Jeton d'API R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Nom du bucket
R2_BUCKET_NAME=bys-medias

# URL publique du bucket : soit le domaine r2.dev fourni par Cloudflare,
# soit un domaine personnalisé (ex. https://medias.bysconsulting.fr).
# Sans slash final.
R2_PUBLIC_URL=
